{
  "version": "7.3",
  "data_api_version": "3.0",
  "routing_model": {
    "RECRUITER_REGISTRATION": []
  },
  "screens": [
    {
      "id": "RECRUITER_REGISTRATION",
      "title": "Recruiter Registration",
      "terminal": true,
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "Form",
            "name": "registration_form",
            "children": [
              {
                "type": "TextInput",
                "name": "company_name",
                "label": "Company / Shop Name",
                "input-type": "text",
                "required": true,
                "helper-text": "Enter the name of your business"
              },
              {
                "type": "Dropdown",
                "name": "business_type",
                "label": "Business Type",
                "required": true,
                "data-source": [
                  {
                    "id": "company",
                    "title": "Company / Pvt Ltd"
                  },
                  {
                    "id": "shop_retail",
                    "title": "Shop / Supermarket / Textiles"
                  },
                  {
                    "id": "hotel_bakery",
                    "title": "Hotel / Restaurant / Bakery"
                  },
                  {
                    "id": "healthcare",
                    "title": "Hospital / Clinic / Pharmacy"
                  },
                  {
                    "id": "education",
                    "title": "School / College / Coaching"
                  },
                  {
                    "id": "salon_spa",
                    "title": "Salon / Beauty Parlour / Spa"
                  },
                  {
                    "id": "finance_bank",
                    "title": "Finance / Co-operative Bank"
                  },
                  {
                    "id": "it_media",
                    "title": "IT / Media / Printing Studio"
                  },
                  {
                    "id": "contractor",
                    "title": "Contractor / Builder"
                  },
                  {
                    "id": "transport",
                    "title": "Travels / Transport / Logistics"
                  },
                  {
                    "id": "workshop_garage",
                    "title": "Workshop / Garage"
                  },
                  {
                    "id": "petrol_pump",
                    "title": "Petrol Pump / Gas Station"
                  },
                  {
                    "id": "agency",
                    "title": "HR / Recruitment / Consultancy"
                  },
                  {
                    "id": "individual",
                    "title": "Individual / Household"
                  },
                  {
                    "id": "other",
                    "title": "Other"
                  }
                ]
              },
              {
                "type": "Dropdown",
                "name": "location",
                "label": "Business Location",
                "required": true,
                "data-source": [
                  {
                    "id": "Kerala",
                    "title": "Kerala"
                  },
                  {
                    "id": "Karnataka",
                    "title": "Karnataka"
                  },
                  {
                    "id": "GCC",
                    "title": "GCC (Gulf Countries)"
                  },
                  {
                    "id": "Other",
                    "title": "Other"
                  }
                ]
              },
              {
                "type": "TextInput",
                "name": "business_contact",
                "label": "Contact Number",
                "input-type": "phone",
                "required": true,
                "helper-text": "Enter the primary contact number for your business"
              }
            ]
          },
          {
            "type": "Footer",
            "label": "Complete Registration",
            "on-click-action": {
              "name": "complete",
              "payload": {
                "company_name": "${form.company_name}",
                "business_type": "${form.business_type}",
                "location": "${form.location}",
                "business_contact": "${form.business_contact}"
              }
            }
          }
        ]
      }
    }
  ]
}