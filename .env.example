# ─────────────────────────────────────────────────────────────────────────────
# .env.example — JobInfo Backend Configuration Template
# Copy this file to .env and fill in the real values before running the app.
# NEVER commit .env to Git. This file (.env.example) is safe to commit.
# ─────────────────────────────────────────────────────────────────────────────

# ─── WhatsApp Cloud API ───────────────────────────────────────────────────────
WHATSAPP_TOKEN=your_whatsapp_cloud_api_token
WHATSAPP_BUSINESS_ACCOUNT_ID=your_waba_id
WHATSAPP_PHONE_ID=your_phone_number_id
APP_SECRET=your_app_secret_from_meta_dashboard
VERIFY_TOKEN=your_custom_webhook_verify_token
WA_CHANNEL_ID=your_whatsapp_channel_phone_number_id

# ─── Admin ────────────────────────────────────────────────────────────────────
# Legacy single admin number (deprecated, kept for backward compat)
ADMIN_WA_NUMBER=91XXXXXXXXXX
# Comma-separated WA numbers that receive new vacancy submission alerts
ADMIN_SUBMISSION_ALERT_NUMBERS=91XXXXXXXXXX,91XXXXXXXXXX
# Comma-separated WA numbers that receive vacancy approval alerts
ADMIN_APPROVAL_ALERT_NUMBERS=91XXXXXXXXXX,91XXXXXXXXXX
# Business WhatsApp number (the API-enabled number job seekers message)
BUSINESS_WA_NUMBER=91XXXXXXXXXX

ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me_to_a_strong_password

# ─── Database ─────────────────────────────────────────────────────────────────
# SQLite (local dev):
DATABASE_URL=sqlite:///./jobinfo.db
# PostgreSQL (production):
# DATABASE_URL=postgresql://user:password@localhost:5432/jobinfo_db

# ─── Feature Flags ────────────────────────────────────────────────────────────
# Set to true when ready to enforce subscription plans
SUBSCRIPTION_ENABLED=false

# ─── Storage ──────────────────────────────────────────────────────────────────
MEDIA_UPLOAD_DIR=uploads/cvs

# ─── App ──────────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=your_long_random_secret_key

# Local dev:  APP_BASE_URL=http://localhost:8080
# Production: APP_BASE_URL=https://jobinfo.pro
APP_BASE_URL=http://localhost:8080

# ─── WhatsApp Flows Encryption ────────────────────────────────────────────────
FLOW_PRIVATE_KEY_PATH=keys/flow_private.pem
FLOW_PRIVATE_KEY_PASSPHRASE=

# ─── WhatsApp Flow IDs ────────────────────────────────────────────────────────
FLOW_ID_SEEKER_REGISTER=your_seeker_register_flow_id
FLOW_ID_SELECT_PLAN=your_select_plan_flow_id
FLOW_ID_CV_UPDATE=your_cv_update_flow_id
FLOW_ID_MY_APPLICATIONS=your_my_applications_flow_id
FLOW_ID_RECRUITER_REGISTER=your_recruiter_register_flow_id
FLOW_ID_MY_VACANCIES=your_my_vacancies_flow_id
FLOW_ID_POST_VACANCY=your_post_vacancy_flow_id
